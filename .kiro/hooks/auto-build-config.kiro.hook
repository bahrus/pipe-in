{
    "name": "Auto-build Configuration",
    "version": "1.0.0",
    "description": "Automatically runs npm run build when emc.mjs is saved, regenerating the JSON configuration file",
    "when": {
        "type": "fileEdited",
        "patterns": ["emc.mjs", "⇥.mjs"]
    },
    "then": {
        "type": "runCommand",
        "command": "npm run build",
        "timeout": 10000
    }
}
